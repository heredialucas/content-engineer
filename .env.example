# ── OpenAI (activo) ─────────────────────────────────────────────
# Motor de texto para ideas, hooks, guiones, storyboards y captions.
OPENAI_API_KEY=
# Modelo por defecto: gpt-5.6-luna (económico). Alternativas: gpt-5.6-terra, gpt-5.6-sol
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Esfuerzo de razonamiento: none | low | medium | high
OPENAI_REASONING=low

# ── Futuros proveedores (sin implementación aún) ────────────────
# Voz / voiceover
ELEVENLABS_API_KEY=
# Bancos de stock gratis (imágenes y videos de fondo)
PEXELS_API_KEY=
PIXABAY_API_KEY=
