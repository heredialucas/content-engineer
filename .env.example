# ── OpenAI (activo) ─────────────────────────────────────────────
# Motor de texto para análisis, briefs, hooks, composiciones y captions.
OPENAI_API_KEY=
# Modelo por defecto: gpt-5.6-luna (económico). Alternativas: gpt-5.6-terra, gpt-5.6-sol
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Esfuerzo de razonamiento: none | low | medium | high
OPENAI_REASONING=low

# ── Imágenes IA (la app web genera y puede editar una referencia) ────────────
# Default: gpt-image-2.5-flare (rápido). Alternativa: gpt-image-2.5-sunburst (edición precisa).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Calidad: low | medium | high | auto
OPENAI_IMAGE_QUALITY=high

# ── Content Studio (web) ─────────────────────────────────────────
# Private single-user access. Use a long unique password and a random secret.
APP_PASSWORD=
SESSION_SECRET=
# Optional persistent project directory; defaults to ./projects
# CONTENT_PROJECTS_DIR=

# Asset conditioner: on = limpia/recorta los screenshots oficiales (assets/screenshots)
# con GPT-Image-2.5 antes de usarlos. Cuesta tokens; default off.
ASSET_CONDITION=off

# ── Futuros proveedores (sin implementación aún) ────────────────
# Voz / voiceover
ELEVENLABS_API_KEY=
# Bancos de stock gratis (imágenes y videos de fondo)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Buffer (publicación) ───────────────────────────────────────
# API key personal: Buffer → Settings → API
BUFFER_API_KEY=
# Organization y channels conectados (corré: pnpm buffer:channels)
BUFFER_ORG_ID=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_LINKEDIN=
BUFFER_CHANNEL_X=

# ── Hosting de medios ──────────────────────────────────────────
# Buffer NO acepta uploads: hay que pasar una URL pública y estable.
# MEDIA_HOST=cloudinary | catbox (prueba) | (vacío = no se adjuntan medios)
MEDIA_HOST=
# Cloudinary (recomendado). Opción 1: URL firmada con api_key + api_secret.
CLOUDINARY_URL=
# Opción 2 (unsigned): cloud name + upload preset
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
